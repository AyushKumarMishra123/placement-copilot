# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/placement_copilot?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/placement_copilot

# JWT Secret Key for Session Authentication
JWT_SECRET=super_secret_jwt_key_replace_in_production_123456

# Allowed Frontend Client Origin
CLIENT_URL=http://localhost:5173

# Python Document Processing Microservice (ai-service)
AI_SERVICE_URL=http://localhost:8000

# Storage Provider: 'gridfs' (production MongoDB GridFS) or 'local'
STORAGE_PROVIDER=gridfs

# AI Intelligence Review Provider: 'gemini' | 'rule-only'
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional GitHub Personal Access Token (for higher API rate limit quota: 5,000 req/hr vs 60 req/hr)
# Kept strictly server-side. Never exposed to frontend or persisted in client profiles.
GITHUB_TOKEN=

# SerpApi Google Jobs Search Configuration
# Sign up and obtain your private API key at https://serpapi.com
# Keep this strictly server-side. Never expose to client bundles.
SERPAPI_API_KEY=
JOBS_DEFAULT_COUNTRY=in
JOBS_DEFAULT_LANGUAGE=en
JOBS_DEFAULT_LOCATION=Bengaluru, Karnataka, India

# Judge0 Online Code Execution Configuration
# Options:
# 1) Public Judge0 CE (Default demo/testing): https://ce.judge0.com (leave JUDGE0_API_KEY empty)
# 2) RapidAPI Judge0 CE: https://judge0-ce.p.rapidapi.com (requires RapidAPI Key in JUDGE0_API_KEY)
# 3) Self-hosted Judge0 CE: http://localhost:2358 (with optional X-Auth-Token in JUDGE0_API_KEY)
# JUDGE0_AUTH_TYPE options: 'auto' (detects RapidAPI by host or X-Auth-Token), 'rapidapi', 'bearer', 'header'
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_AUTH_TYPE=auto
